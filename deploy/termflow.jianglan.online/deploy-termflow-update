#!/usr/bin/env bash
set -euo pipefail

readonly STAGING_DIR="/home/ubuntu/termflow-update-staging"
readonly WEB_ROOT="/opt/1panel/www/sites/termflow.jianglan.online/index"
readonly RELEASE_DIR="${WEB_ROOT}/releases"

shopt -s nullglob
installers=("${STAGING_DIR}"/Termflow_[0-9]*_x64-setup.exe)

if [[ ${#installers[@]} -ne 1 ]]; then
  echo "Expected exactly one Termflow installer in ${STAGING_DIR}." >&2
  exit 1
fi

readonly INSTALLER_PATH="${installers[0]}"
readonly INSTALLER_NAME="$(basename "${INSTALLER_PATH}")"
readonly SIGNATURE_PATH="${INSTALLER_PATH}.sig"
readonly MANIFEST_PATH="${STAGING_DIR}/latest.json"

if [[ ! -s "${SIGNATURE_PATH}" || ! -s "${MANIFEST_PATH}" ]]; then
  echo "The installer signature or latest.json is missing." >&2
  exit 1
fi

if [[ ! "${INSTALLER_NAME}" =~ ^Termflow_([0-9]+\.[0-9]+\.[0-9]+)_x64-setup\.exe$ ]]; then
  echo "Unexpected installer name: ${INSTALLER_NAME}" >&2
  exit 1
fi

readonly VERSION="${BASH_REMATCH[1]}"
python3 - "${MANIFEST_PATH}" "${VERSION}" "${INSTALLER_NAME}" <<'PYTHON'
import json
import sys

manifest_path, version, installer_name = sys.argv[1:]
with open(manifest_path, encoding="utf-8") as manifest_file:
    manifest = json.load(manifest_file)

platform = manifest["platforms"]["windows-x86_64"]
expected_suffix = f"/releases/{installer_name}"
if manifest["version"] != version or not platform["url"].endswith(expected_suffix) or not platform["signature"].strip():
    raise SystemExit("The updater manifest does not match the staged signed installer.")
PYTHON

install -d -m 0755 "${RELEASE_DIR}"
install -m 0644 "${INSTALLER_PATH}" "${RELEASE_DIR}/${INSTALLER_NAME}"
install -m 0644 "${SIGNATURE_PATH}" "${RELEASE_DIR}/${INSTALLER_NAME}.sig"

# Replace the manifest last, after the referenced immutable release files exist.
readonly TEMP_MANIFEST="$(mktemp "${WEB_ROOT}/.latest.json.XXXXXX")"
trap 'rm -f "${TEMP_MANIFEST}"' EXIT
install -m 0644 "${MANIFEST_PATH}" "${TEMP_MANIFEST}"
mv -f "${TEMP_MANIFEST}" "${WEB_ROOT}/latest.json"

rm -f "${INSTALLER_PATH}" "${SIGNATURE_PATH}" "${MANIFEST_PATH}"
echo "Published Termflow ${VERSION}."
