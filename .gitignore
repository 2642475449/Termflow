# Dependencies
node_modules/
.pnpm-store/
.npm-token-tracker-cache/

# Build
dist/
src-tauri/target/*
!src-tauri/target/release/
src-tauri/target/release/*
!src-tauri/target/release/bundle/
src-tauri/target/release/bundle/*
!src-tauri/target/release/bundle/nsis/
src-tauri/target/release/bundle/nsis/*

# Self-hosted updater release manifests (uploaded to the update server)
output/updates/
output/release-v*/

# Local documentation
# 注意：必须用 docs/* 而不是 docs/，否则 Git 不会遍历 docs 目录，
# 下面对 architecture/ 的 ! 取反规则将完全不生效。
docs/*
!docs/architecture/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local AI tooling and workspace state
.agents/
.claude/*
.corepack/
.trae/
.workbuddy/
.mcp.json
.claude/settings.local.json


# Shared Termflow release skills for Codex and Claude Code
!.agents/
!.agents/skills/
!.agents/skills/termflow-github-release/
!.agents/skills/termflow-github-release/**
!.claude/
!.claude/skills/
!.claude/skills/termflow-github-release/
!.claude/skills/termflow-github-release/**
