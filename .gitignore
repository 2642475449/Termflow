# Dependencies
node_modules/
.pnpm-store/
.npm-token-tracker-cache/

# Build
dist/
public/flyfish-viewer-assets.json
public/vendor/
src-tauri/target/*
!src-tauri/target/release/
src-tauri/target/release/*
!src-tauri/target/release/bundle/
src-tauri/target/release/bundle/*
!src-tauri/target/release/bundle/nsis/
src-tauri/target/release/bundle/nsis/*

# Self-hosted updater release manifests (uploaded to the update server)
output/updates/
output/release-v*/

# Local documentation
# 注意：必须用 docs/* 而不是 docs/，否则 Git 不会遍历 docs 目录，
# 下面对 architecture/ 的 ! 取反规则将完全不生效。
docs/*
!docs/architecture/

# IDE
.vscode/
.idea/
*.swp
*.swo
.agents/teamwork/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local AI tooling and workspace state
AGENTS.md
AGENTS.local.md
CLAUDE.md
CLAUDE.local.md
.termflow/
.agents/
.codex-tmp/
.claude/
.qoder/
.corepack/
.trae/
.workbuddy/
.mcp.json

# Shared Termflow skills
!.agents/
!.agents/skills/
!.agents/skills/termflow-github-release/
!.agents/skills/termflow-github-release/**

# Locally installed third-party skills
/.agents/skills/design-taste-frontend/
/.taste-skill/
/skills-lock.json
